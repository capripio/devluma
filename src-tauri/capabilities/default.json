    "allow-check-app-update",
    "allow-install-app-update",
    "allow-preview-diagnostics",
    "allow-export-diagnostics",
    "allow-open-diagnostics-folder",
    "allow-preview-uninstall",
    "allow-uninstall-package",
    "allow-set-service-ports",
    "allow-list-database-services",

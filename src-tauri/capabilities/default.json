    "allow-preview-restore",
    "allow-restore-database",
    "allow-get-ngrok-status",
    "allow-set-ngrok-path",
    "allow-set-ngrok-token",
    "allow-remove-ngrok-token",
    "allow-list-tunnels",
    "allow-start-tunnel",
    "allow-stop-tunnel",
    "allow-list-sites",
    "allow-preview-site",
    "allow-apply-site",
    "allow-remove-site",

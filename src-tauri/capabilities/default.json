  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-theme",
    "allow-get-app-info",
    "allow-get-startup-status",
    "allow-list-operations",
    "allow-cancel-operation",
    "allow-list-packages",
    "allow-install-package",
    "allow-preview-runtime-switch",
    "allow-apply-runtime-switch",
    "allow-get-php-details",
    "allow-create-php-ini",
    "allow-list-projects",
    "allow-create-project",
    "allow-remove-project",
    "allow-open-project-terminal",
    "allow-list-services",
    "allow-create-service",
    "allow-start-service",
    "allow-stop-service",
    "allow-restart-service",
    "allow-get-service-details",
    "allow-remove-service",
    "allow-open-service-ui",
    "allow-get-setup-status",
    "allow-choose-storage",
    "allow-run-setup",
    "allow-complete-setup",
    "allow-restart-app",
    "allow-reopen-setup",
    "allow-get-update-settings",
    "allow-set-update-urls",
